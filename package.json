{
  "name": "lovely-chart",
  "version": "2.3.5",
  "description": "Telegram-style charts for the web that look lovely out of the box: a minimalist design, a refined day and night palette and smooth, touch-friendly interactions. Tiny and dependency-free, with a minimap and drill-down zoom",
  "type": "module",
  "main": "./dist/LovelyChart.js",
  "types": "./dist/LovelyChart.d.ts",
  "exports": {
    ".": {
      "types": "./dist/LovelyChart.d.ts",
      "default": "./dist/LovelyChart.js"
    },
    "./LovelyChart.css": "./dist/LovelyChart.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/*",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "*.css",
    "*.scss"
  ],
  "scripts": {
    "dev": "npm run demo && vite docs --config vite.config.js",
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "typecheck:consumer": "tsc -p test/nodenext",
    "lint": "eslint .",
    "lint:css": "stylelint \"src/**/*.scss\"",
    "test": "npm run typecheck && npm run lint && npm run lint:css && npm run build && npm run typecheck:consumer && node test/e2e.js",
    "prepublishOnly": "npm run build",
    "demo": "npm run build && cp ./dist/LovelyChart.js ./dist/LovelyChart.css ./CHANGELOG.md docs/ && node scripts/site.js",
    "thumbnails": "npm run build && node scripts/thumbnails.js",
    "prepare": "(husky || true) && npm run build"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts}": "eslint --fix",
    "*.scss": "stylelint --fix"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^6.0.1",
    "eslint": "^10.15.0",
    "eslint-plugin-no-null": "^1.0.2",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.1",
    "playwright-core": "^1.65.1",
    "sass": "^1.108.2",
    "stylelint": "^18.1.0",
    "stylelint-config-clean-order": "^10.0.0",
    "stylelint-config-recommended-scss": "^18.0.0",
    "stylelint-order": "^8.1.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/Ajaxy/lovely-chart.git"
  },
  "keywords": [
    "chart",
    "graph",
    "plot",
    "canvas",
    "typescript",
    "lightweight",
    "interactive",
    "line",
    "area",
    "bar",
    "pie",
    "donut",
    "minimap",
    "zoom",
    "time-series",
    "beautiful",
    "minimalist",
    "animated",
    "dark-mode",
    "touch",
    "telegram",
    "telegram-style",
    "telegram-charts"
  ],
  "author": "Alexander Zinchuk",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Ajaxy/lovely-chart/issues"
  },
  "homepage": "https://lovelychart.io/"
}
